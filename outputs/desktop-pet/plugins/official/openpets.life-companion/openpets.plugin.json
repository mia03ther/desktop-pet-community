{
  "manifestVersion": 3,
  "id": "openpets.life-companion",
  "name": "$t:plugin.name",
  "description": "$t:plugin.description",
  "version": "1.1.0",
  "runtime": "javascript",
  "icon": "heart",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "assets": {
    "icons": {
      "life-companion": "assets/life-companion.svg"
    }
  },
  "permissions": [
    "pet:speak",
    "pet:interact",
    "pets:read",
    "schedule",
    "storage",
    "commands",
    "events",
    "bus"
  ],
  "configSchema": {
    "stretchReminder": {
      "type": "boolean",
      "default": false,
      "label": "$t:config.stretch",
      "description": "$t:config.stretchDescription"
    },
    "eyeReminder": {
      "type": "boolean",
      "default": false,
      "label": "$t:config.eyes",
      "description": "$t:config.eyesDescription"
    },
    "nightReminder": {
      "type": "boolean",
      "default": false,
      "label": "$t:config.night",
      "description": "$t:config.nightDescription"
    }
  }
}
