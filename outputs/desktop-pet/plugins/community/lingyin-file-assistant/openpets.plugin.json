{
  "manifestVersion": 3,
  "id": "lingyin.file-assistant",
  "name": "文件助手",
  "description": "可选本机工具：快速定位文件、打开目录、虚拟分类库、可撤销推荐整理及用户配置 AI 的分类审核。功能由桌宠工作室宿主提供，安装启用后从插件配置进入。",
  "version": "1.0.0",
  "runtime": "javascript",
  "sdkVersion": "3.0.0",
  "entry": "index.js",
  "icon": "plugin",
  "permissions": ["files", "status"]
}
